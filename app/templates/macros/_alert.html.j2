{% macro alert(type, message) %}
    {% set colors = {
        'info': {'text': 'text-blue-700', 'bg': 'bg-blue-100'},
        'success': {'text': 'text-green-700', 'bg': 'bg-green-100'},
        'warning': {'text': 'text-yellow-700', 'bg': 'bg-yellow-100'},
        'error': {'text': 'text-red-700', 'bg': 'bg-red-100'}
    } %}
    {% set color = colors[type] %}
    <div
        class="fixed top-4 right-4 z-100 flex items-center w-max min-w-md px-3 py-2 rounded  shadow-sm shadow-app-neutral-400 {{ color.bg }} {{ color.text }}"
        x-show="showAlert"
        x-transition:enter="duration-300"
        x-transition:enter-start="opacity-0 translate-x-4"
        x-transition:enter-end="opacity-100 translate-x-0"
        x-transition:leave="duration-300"
        x-transition:leave-start="opacity-100 translate-x-0"
        x-transition:leave-end="opacity-0 translate-x-4"
    >
        <div class="flex-1 flex items-center gap-4">
            {% if type == 'info' %}
                <i data-lucide="ckeck" class="size-5 {{ color.text }}"></i>
            {% elif type == 'success' %}
                <i data-lucide="info" class="size-5 {{ color.text }}"></i>
            {% elif type == 'warning' %}
                <i data-lucide="triangle-alert" class="size-5 {{ color.text }}"></i>
            {% elif type == 'error' %}
                <i data-lucide="circle-minus" class="size-5 {{ color.text }}"></i>
            {% endif %}
            <p>{{ message }}</p>
        </div>
        <button x-on:click="showAlert = false;">
            <i data-lucide="x" class="size-5"></i>
        </button>
    </div>
{% endmacro %}

