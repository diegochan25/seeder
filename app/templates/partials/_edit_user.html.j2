{# begin overlay #}
<div 
    class="fixed inset-0 z-50 flex justify-center items-center backdrop-brightness-75 backdrop-blur-xs"
    x-show="showForm" 
    x-on:click="showForm = false" 
    x-transition:enter="duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4" 
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="duration-200" 
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
>
    {# begin dialog #}
    <div 
        class="relative space-y-6 bg-white rounded-xl w-xl min-h-0 h-max overflow-y-auto max-h-[80vh] shadow-sm shadow-app-neutral-600 p-6"
        x-on:click.stop
    >
        <button 
            class="absolute top-2 right-2 p-0.5 rounded-lg hover:bg-neutral-100 duration-150"
            x-on:click="showForm = false"
        >
            <i data-lucide="x" class="size-5 text-app-ink-200"></i>
        </button>
        <div class="space-y-1">
            <h2 class="text-xl font-semibold">Edit profile</h2>
            <p class="text-zinc-500">Change your account details, add a profile picture, view your personal info.</p>
        </div>
        <form hx-patch="/users/{{session.user.autoid}}" class="space-y-4" x-on:submit="showForm = false">
        |
        </form>
    </div>
    {# end dialog #}
</div>
{# end overlay #}
