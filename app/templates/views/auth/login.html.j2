{% extends layout('auth.html.j2') %}

{% block title %}Sign in | Seeder{% endblock %}

{% block content %}
<div class="w-full max-w-xl p-4 flex flex-col gap-12">
    <div>
        {% include partial('_logo.html.j2') %}
    </div>
    <div class="space-y-2">
        <h2 class="text-4xl font-semibold">Welcome back</h2>
        <p class="text-lg text-zinc-500">
            Your schemas, generators and formatters 
            live on your account. Seeder never asks 
            for database credentials.
        </p>
    </div>
    <form action="/auth/login" method="post" class="space-y-6">
        <div class="space-y-2" x-data="{email: '{{ new_login.email }}'}">
            <label for="email" class="block text-sm font-medium">Email address</label>
            <div class="w-full flex items-center gap-2 px-2 py-1 border border-zinc-300 rounded-lg outline-2 outline-transparent has-focus:outline-yellow-300 duration-150">
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="flex-1 focus:outline-0" 
                    x-model="email"
                >
            </div>
        </div>    
        <div class="space-y-2" x-data="{password: '{{ new_login.password }}', visible: false}">
            <div class="w-full flex items-center text-sm">
                <label for="password" class="flex-1 font-medium">Password</label>
                <a href="/auth/password/forgot" class="text-yellow-600 hover:text-yellow-700 hover:underline">Forgot password?</a>
            </div>
            <div class="w-full flex items-center gap-2 px-2 py-1 border border-zinc-300 rounded-lg outline-2 outline-transparent has-focus:outline-yellow-300 duration-150">
                <input 
                    x-bind:type="visible ? 'text' : 'password'"
                    id="password" 
                    name="password" 
                    class="flex-1 focus:outline-0" 
                    x-model="password"
                >
                <button type="button" x-on:click="visible = !visible">
                    <i data-lucide="eye" x-show="visible" class="size-5 text-blue-500"></i>
                    <i data-lucide="eye-closed" x-show="!visible" class="size-5 text-zinc-400"></i>
                </button>
            </div>
        </div>
        <div x-data="{rememberMe: {{ new_login.remember_me | lower }}}">
            <label for="rememberMe" class="flex items-center gap-4">
                <div class="rounded-md size-5 border border-neutral-400 flex justify-center items-center cursor-pointer bg-white hover:bg-neutral-100 duration-150">
                    <i data-lucide="check" x-show="rememberMe" class="text-blue-500" x-transition></i>
                </div>
                <span>Keep me signed in</span>
                <input type="checkbox" id="rememberMe" class="hidden" name="remember_me" x-model="rememberMe">
            </label>
        </div>  
        <div>
            <input type="submit" value="Sign in" class="w-full border border-yellow-300 px-3 py-2 rounded-lg bg-yellow-300 hover:bg-yellow-400 font-medium duration-150 shadow-xs shadow-zinc-200">
        </div> 
    </form>
    <div class="relative">
        <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-neutral-400"></div>
        </div>
        <div class="relative flex justify-center">
            <span class="bg-white px-4 text-neutral-500">or</span>
        </div>
    </div>
    <div class="space-y-4">
        <a href="" class="w-full px-3 py-2 rounded-lg border border-neutral-400 flex justify-center items-center gap-2">
            <img src="/static/svg/github.svg" class="size-5">
            Continue with GitHub
        </a>
        <a href="" class="w-full px-3 py-2 rounded-lg border border-neutral-400 flex justify-center items-center gap-2">
            <img src="/static/svg/google.svg" class="size-5">
            Continue with Google
        </a>
    </div>
</div>
{% endblock %}